APP_NAME="Social CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Cloudways workers can only use the redis driver: keep this above the longest worker --timeout (commercelong 3600)
REDIS_QUEUE_RETRY_AFTER=3700
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# 127.0.0.1, not localhost: on Windows "localhost" can resolve to IPv6 (::1) first and server-side broadcasts to Reverb fail.
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social CRM
CRM_CHANNEL_DRIVER=fake
CRM_COMMERCE_DRIVER=fake
CRM_SHIPPING_DRIVER=fake
CRM_AI_DRIVER=fake
# Fake-driver (and TikTok) webhooks carry no signature: accepted automatically only when APP_ENV is local/testing.
CRM_ALLOW_FAKE_WEBHOOKS=false

# Staging health check (GET /up/crm, header X-Health-Token). Empty = endpoint always 404s.
CRM_HEALTH_TOKEN=

META_APP_ID=
META_APP_SECRET=
# Optional Facebook Login for Business configuration id (replaces the scope list).
META_LOGIN_CONFIG_ID=
META_VERIFY_TOKEN=crm-verify
META_GRAPH_VERSION=v23.0

SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=

CRM_DEV_QUICK_LOGIN=false
# Developer-only pages (simulator, latency report): hidden and 404 unless true.
CRM_DEV_TOOLS=false

# Public legal pages (/privacy, /terms, /data-deletion) for Meta App Review.
LEGAL_COMPANY_NAME="Le Voile"
LEGAL_CONTACT_EMAIL=
LEGAL_RETENTION_MONTHS=24

# Hosted Pusher Channels (use on servers where a Reverb daemon is impractical, e.g. Cloudways):
# BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

CRM_ADS_HISTORY_START=2026-09-01
# Days an ad referral stays valid for crediting an inbox order to the ad (attribution window).
CRM_ADS_INBOX_WINDOW_DAYS=7
# Queue of the ads sync jobs. Set to adssync ONLY after the crm-adssync Supervisor program exists
# (deploy/cloudways/supervisor/crm-workers.conf), otherwise nothing consumes the jobs. Rollback: commercelong.
CRM_ADS_SYNC_QUEUE=commercelong
# Quota admission: hold Meta reads while the account's recent usage is >= 75 %. false = off.
CRM_ADS_SYNC_ADMISSION=true
# Non-production only: live ad writers may touch just these accounts (comma list of act_...). Empty = none.
CRM_ADS_WRITE_SANDBOX_ACCOUNTS=
# Deploy-level kill switch for CRM ad writes (Run, publish). false = off whatever ads:writes says. Stop always works.
CRM_ADS_WRITES_ENABLED=true
# Queue of the delayed retry of a confirmed Stop (short jobs; must be served by a worker with --timeout below retry_after).
CRM_ADS_WRITE_RETRY_QUEUE=commerce
# Run guard: highest per-day budget (minor units) a CRM Run may switch on. 2000000 = EGP 20,000 (ASSUMPTION, owner to confirm).
# Per-user / per-account overrides: php artisan ads:write-limits --set=max_daily_budget_minor=... [--account=|--user=]
CRM_ADS_MAX_DAILY_BUDGET_MINOR=2000000

# Control room S3: conversation outcomes are tracked from this date (Cairo). Set it to the deploy date:
# nothing earlier (messages, orders, handovers) counts toward an episode, and the idle sweep never backfills history.
CRM_OUTCOMES_FROM=2026-10-08
# Hours of silence before the hourly sweep ends a chat nobody closed (bot-only / forgotten chats).
CRM_OUTCOMES_IDLE_HOURS=24
